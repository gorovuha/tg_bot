# Required — token from @BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# Classifier backend: retrieval (default; needs data/index/, see README) | mock (keyword heuristics, tests only)
CLASSIFIER_BACKEND=retrieval

# Override the calibrated propaganda threshold (cosine similarity to the nearest EUvsDisinfo case)
# RETRIEVAL_THRESHOLD=0.82

# SQLite path (default: ./data/bot.db)
# BOT_DB_PATH=/data/bot.db
